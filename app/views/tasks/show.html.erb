<div class="container mt-4">
  <h2 class="mb-3"><%= @task.title %></h2>
  <p><strong>Details: </strong> <%= @task.details %></p>
  <p><strong>Status:</strong> <%= @status %></p>

  <div class="mt-4">
    <%= link_to "Back to List", tasks_path, class: "btn btn-secondary me-2" %>
    <%= link_to "Edit task", edit_path, class: "btn btn-primary me-2" %>
    <%= link_to "Delete",
      delete_path(@task),
      data: { turbo_method: :delete, turbo_confirm: "Are you sure?" },
      class: "btn btn-danger"
    %>
  </div>
</div>
